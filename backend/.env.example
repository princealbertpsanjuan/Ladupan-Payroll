MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/ladupan-payroll
JWT_SECRET=replace-with-a-long-random-string
PORT=5000
APP_TIMEZONE=Asia/Manila
# Deployed frontend address(es), comma-separated. Leave empty locally.
# FRONTEND_URL=https://ladupan-payroll.vercel.app

# Real visitor IP for the shop network restriction:
# - On Render: CLIENT_IP_HEADER=true-client-ip
# - Behind another single proxy (Railway, Nginx): TRUST_PROXY=1
# - Local / direct connection: leave both unset
# CLIENT_IP_HEADER=true-client-ip
# TRUST_PROXY=1
